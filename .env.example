RCON_HOST=127.0.0.1
RCON_PORT=28016
RCON_PASSWORD=your_secret_password
RCON_TIMEOUT=5
ACCESS_LEVEL=safe

# Нужно только для подключения из ChatGPT (или другого клиента, обращающегося
# по сети). Для Claude Desktop оставьте MCP_TRANSPORT=stdio (или не задавайте вовсе).
MCP_TRANSPORT=stdio
MCP_HOST=127.0.0.1
MCP_PORT=8000

# Обязателен при MCP_TRANSPORT=streamable-http — общий секрет для заголовка
# Authorization: Bearer <token>. Сгенерировать:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_BEARER_TOKEN=